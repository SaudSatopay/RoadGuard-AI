# Nothing here is required: the citizen app calls /api, which Vite proxies to the backend on http://127.0.0.1:8000.
# Copy to .env only to override a VITE_ value.

# Call an API on another origin instead of the /api proxy (the backend must allow that origin).
# VITE_API_URL=https://api.example.org

# Read from the shell environment by vite.config.js, not from .env:
#   ROADGUARD_API=http://127.0.0.1:8000        backend the dev and preview proxy forward /api to
#   ROADGUARD_SITE_URL=https://example.org     at build time, makes the share card's og:image absolute
