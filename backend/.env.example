# RoadGuard AI backend settings. Copy to `backend/.env` and fill in. Never commit the real .env.

# JWT signing secret. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left unset, a random per-process secret is used (sign-ins reset on restart).
JWT_SECRET_KEY=

# Inference device: auto (default), cuda or cpu. On CPU, model/roadguard_det.onnx is used when present.
ROADGUARD_DEVICE=auto

# Optional: drafts complaint letters with Claude. Without it, letters use the built-in template.
ANTHROPIC_API_KEY=

# Optional: WhatsApp bot through the Twilio sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
