# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local SSL certs (do not commit — machine-specific)
*.pem
.env
.env.*

# Backend shared runtime store (ephemeral, regenerates on startup)
backend/shared_store.json

# Allow example env templates (real .env stays ignored above)
!.env.example

# Local TLS certs (machine-specific, never commit)
certs/

# RoadGuard AI: training data, runs and downloaded base weights (reproducible via training/*.py)
training/data/
training/runs/
training/weights/
training/results/val_runs/
# Missile working files (screenshots, Lighthouse, scorecards)
.missile/
# Backend virtual environment and runtime uploads
backend/.venv/
backend/uploads/
# Launcher state
.roadguard/
# RoadGuard AI runtime state (store file; regenerates from backend/seed on first start)
backend/data/

# Ultralytics AMP-check weights and agent worktrees
training/*.pt
*.pt.tmp
.claude/worktrees/
